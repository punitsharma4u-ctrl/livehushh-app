# Copy to `.env` and fill values. Amplify env vars override these at build time.

# Set to "true" to call the real Lambda API. When unset/false, app uses mock data.
REACT_APP_USE_API=false

# AWS API Gateway base URL (points to your existing Lambda).
REACT_APP_API_BASE=https://j76uxpya68.execute-api.us-east-1.amazonaws.com/prod

# Cognito (only needed once you wire real sign-in)
REACT_APP_COGNITO_REGION=us-east-1
REACT_APP_COGNITO_POOL_ID=us-east-1_ewcJ1VvTa
REACT_APP_COGNITO_CLIENT=4fr5c7a8m4h2i4c4hldun0pd3g
